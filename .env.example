# Copiar a .env (no versionado) y completar. Ningún valor real debe subirse al repositorio.

# Ambiente: development | production   (testing lo usan las pruebas automáticas)
AUTOMATE_ENV=development

# Obligatoria en producción. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Base de datos (obligatoria): AUTOMATE_CANELLA en SQL Server. Ver scripts/sqlserver/README.md
# Ejemplos cuando se defina el servidor productivo:
#   DATABASE_URL=mssql+pyodbc://usrAutomate:clave@servidor/AUTOMATE_CANELLA?driver=ODBC+Driver+17+for+SQL+Server  (ver scripts/sqlserver/README.md)
#   DATABASE_URL=postgresql+psycopg://usuario:clave@servidor/automate_canella
DATABASE_URL=
# Segundos antes de renovar una conexión inactiva del pool (menor que el timeout de tu firewall/VPN,
# si no, una conexión que el servidor ya cerró puede fallar en vez de renovarse sola)
DB_POOL_RECYCLE_SEGUNDOS=280

# Inicio de sesión con usuarios de STOD (ASP.NET Membership). El hub solo lee
# aspnet_Users y aspnet_Membership. Pedir las credenciales a Informática; no versionarlas.
STOD_SERVER=
STOD_DATABASE=STOD_SAPBONE
STOD_USERNAME=
STOD_PASSWORD=
# ODBC Driver 17 for SQL Server (por defecto) u ODBC Driver 18 for SQL Server
STOD_ODBC_DRIVER=
STOD_TIMEOUT=10
# Minutos entre verificaciones de que un usuario con sesión abierta siga activo en STOD
STOD_REVALIDAR_MINUTOS=15

# Ejecuciones: al arrancar, las que sigan "en_curso" tras estas horas se marcan "interrumpida".
# Debe ser mayor que la duración de la tarea más larga.
EJECUCIONES_INTERRUMPIDAS_HORAS=2
# Días que se conservan las ejecuciones "sin cambios" (tareas programadas que no encontraron nada)
EJECUCIONES_SIN_CAMBIOS_DIAS=7

# Sesión
# 1 cuando el hub se sirva por HTTPS (en production el valor por defecto ya es 1)
SESSION_COOKIE_SECURE=0
# Minutos sin actividad antes de cerrar la sesión, y horas máximas de una sesión (jornada)
SESION_INACTIVIDAD_MINUTOS=60
SESION_MAXIMA_HORAS=10
# Segundos antes del vencimiento en que aparece el aviso «Extender sesión»
SESION_AVISO_SEGUNDOS=120
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Logs (por defecto: carpeta logs/ del proyecto)
LOG_DIR=
LOG_LEVEL=
LOG_RETENCION_DIAS=
LOG_CONSOLA=1
LOG_ARCHIVO=1

# Módulos a cargar, separados por coma. Vacío = todos los de app/modulos.
#   AUTOMATE_MODULOS=app.modulos.ejemplo
AUTOMATE_MODULOS=

# ---------------------------------------------------------------- Módulo corte_caja
# Requiere: pip install -r requirements-corte_caja.txt. Ver docs/PLAN_INTEGRACION_CORTE_DE_CAJA.md
# simulacion: registra lo que haría sin responder, guardar ni mover correos | real
CORTE_CAJA_MODO=
# Raíz de la carpeta compartida (la cuenta de servicio de la tarea necesita permiso de escritura)
#   CORTE_CAJA_DESTINO=\\SERVIDOR\Corte_de_Caja
CORTE_CAJA_DESTINO=
# Buzón del robot y acceso por EWS (pedir a Informática; no versionar)
CORTE_CAJA_BUZON=
CORTE_CAJA_EWS_SERVIDOR=
CORTE_CAJA_EWS_USUARIO=
CORTE_CAJA_EWS_CONTRASENA=
# Proxy HTTP para llegar al EWS (desde la red interna owa.canella.com.gt solo responde por el proxy)
#   CORTE_CAJA_EWS_PROXY=http://128.1.200.140:8080
CORTE_CAJA_EWS_PROXY=
# Dominios de remitentes a los que se atiende y responde, separados por coma
CORTE_CAJA_DOMINIOS=canella.com.gt
# Correos por corrida (los demás quedan para la siguiente)
CORTE_CAJA_LOTE=20
# Solo correos recibidos desde esta fecha y hora UTC (AAAA-MM-DDTHH:MM). Fijarla al pasar a
# modo real para no procesar el histórico que el prototipo dejó en la bandeja de entrada.
CORTE_CAJA_RECIBIDOS_DESDE=

# ---------------------------------------------------------------- Módulo expedientes_seguros
# Requiere: pip install -r requirements-expedientes_seguros.txt. Ver docs/PLAN_EXPEDIENTES_SEGUROS.md
# SAP Business One, solo lectura (OSCL, SCL4, OINV, ATC1, OPRC). La cuenta del hub además necesita
# lectura en la carpeta de anexos (\\Srv-sapcanella\archivos-sap, servidor 128.1.200.122).
EXPEDIENTES_SAP_SERVIDOR=
EXPEDIENTES_SAP_BASE=SBO_CANELLA
EXPEDIENTES_SAP_USUARIO=
# Entre comillas simples si tiene $
EXPEDIENTES_SAP_CONTRASENA=
EXPEDIENTES_SAP_DRIVER=
# Nombre o IP del servidor de archivos de SAP tal como lo alcanza el hub. SAP guarda las rutas como
# \Srv-sapcanella\...; si ese nombre no resuelve desde el hub, poner aquí su IP. Vacío = usar la ruta tal cual.
EXPEDIENTES_ANEXOS_SERVIDOR=
# Campos de usuario de OINV con la Serie y el Número FEL (confirmados: U_DoctoSerie / U_DoctoNo)
EXPEDIENTES_SAP_CAMPO_SERIE=U_DoctoSerie
EXPEDIENTES_SAP_CAMPO_NUMERO=U_DoctoNo
# Centro de costo (OSCL.U_CECO) que viene escrito en el buscador: 1602 = Servicios Auto Taller Pintura
EXPEDIENTES_CECO_POR_DEFECTO=1602
# Días que se guardan los PDF generados (contienen datos personales); el registro queda
EXPEDIENTES_RETENCION_DIAS=7
# Envío del correo del paquete por SMTP (Exchange de Canella, como CODA Reports). Probar con:
#   flask --app wsgi expedientes_seguros probar-correo tu.correo@canella.com.gt
EXPEDIENTES_SMTP_SERVIDOR=128.1.200.106
EXPEDIENTES_SMTP_PUERTO=587
EXPEDIENTES_SMTP_TLS=1
# Buzón desde el que sale (puede reutilizar el del robot: ${CORTE_CAJA_EWS_USUARIO}). Vacíos = relay sin autenticar
EXPEDIENTES_SMTP_USUARIO=
EXPEDIENTES_SMTP_CONTRASENA=
EXPEDIENTES_SMTP_REMITENTE="Expedientes de Seguros <automatizacionescaja@canella.com.gt>"

# Servidor Waitress (serve.py)
HOST=127.0.0.1
PORT=8000
