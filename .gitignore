# Python
__pycache__/
*.py[cod]
.venv/
.venv.old/
venv/
.pytest_cache/

# Configuración local y secretos
.env
.env.*
!.env.example

# Logs locales
logs/

# Archivos de trabajo de los módulos (p. ej. PDF de expedientes de seguros: datos personales)
instance/

# Material de levantamiento con datos reales (correos, expedientes, DPI): no se versiona
contexto/

# Herramientas locales: cobertura y permisos de Claude Code de esta máquina (rutas y comandos propios)
.coverage
htmlcov/
.claude/settings.local.json

# Playwright: traces y capturas de pruebas que fallan (tests/e2e)
test-results/

# Graphify: se versiona el grafo (graphify-out/), no su caché ni la ruta local de cada equipo
graphify-out/cache/
graphify-out/.graphify_root
